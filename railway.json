{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "npx prisma db push --accept-data-loss && node dist/bot-standalone.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ALWAYS"
  }
}
